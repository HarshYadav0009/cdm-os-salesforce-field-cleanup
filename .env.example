# ==============================================================================
# CDM-OS — Environment Configuration
# Copy this file to .env   →   cp .env.example .env
# The defaults below match docker-compose.yml for zero-config local setup.
# ==============================================================================

# --- System & Deployment Environment ---
CDM_ENV=development
CDM_LOG_LEVEL=DEBUG
CDM_PORT=8000

# --- Database (must match docker-compose.yml postgres service) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cdm_os_db
POSTGRES_USER=cdm_admin
POSTGRES_PASSWORD=cdm_secure_password

# --- Redis (must match docker-compose.yml redis service) ---
REDIS_URL=redis://localhost:6379/0

# --- Identity & Auth ---
CDM_JWT_SECRET=local-dev-jwt-secret-change-in-production
CDM_AUTH_ENABLED=false

# --- Model Gateway (set your key for whichever provider you use) ---
MODEL_DEFAULT_PROVIDER=anthropic
MODEL_FALLBACK_PROVIDER=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Policy Engine ---
POLICY_MODE=enforce
POLICY_DEFINITIONS_PATH=policy/definitions

# --- MCP Tool Gateway ---
MCP_GATEWAY_PORT=8080
MCP_REQUEST_TIMEOUT_SEC=30

# --- Salesforce Sandbox (Dev 2 will configure these) ---
SF_LOGIN_URL=https://test.salesforce.com
SF_USERNAME=
SF_CONSUMER_KEY=
SF_PRIVATE_KEY_PATH=

# --- Audit & Observability ---
AUDIT_HMAC_SECRET=local-dev-hmac-key-change-in-production
AUDIT_LOG_DIR=audit/logs
