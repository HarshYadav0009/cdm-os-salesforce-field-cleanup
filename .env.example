# ==============================================================================
# CDM-OS — Environment Configuration Template
# Copy this file to .env and populate with deployment credentials.
# NEVER commit .env with actual production secrets.
# ==============================================================================

# --- System & Deployment Environment ---
CDM_ENV=development                       # development | staging | production
CDM_LOG_LEVEL=INFO                         # DEBUG | INFO | WARNING | ERROR
CDM_PORT=8000                              # Control Plane API Port

# --- Identity & Access Management (IAM) ---
CDM_JWT_SECRET=super-secret-jwt-key-change-in-production
CDM_AUTH_ENABLED=true
CDM_OIDC_ISSUER=https://auth.company.com/realms/cdm-os
CDM_OIDC_CLIENT_ID=cdm-os-control-plane

# --- Control Plane State Store (PostgreSQL / Redis) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cdm_os_db
POSTGRES_USER=cdm_admin
POSTGRES_PASSWORD=cdm_secure_password_change_me
REDIS_URL=redis://localhost:6379/0

# --- Model Gateway Configuration ---
MODEL_DEFAULT_PROVIDER=anthropic           # anthropic | openai | azure_openai | local_ollama
MODEL_FALLBACK_PROVIDER=openai
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=sk-proj-...
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=...

# --- Tool Gateway & MCP Servers ---
MCP_GATEWAY_PORT=8080
MCP_AUTH_TOKEN=mcp-internal-gateway-token
MCP_REQUEST_TIMEOUT_SEC=30

# --- Target Integration Credentials (Salesforce / Jira / GitHub) ---
SF_LOGIN_URL=https://login.salesforce.com
SF_USERNAME=admin@company.sandbox
SF_CONSUMER_KEY=3MVG9...
SF_PRIVATE_KEY_PATH=./config/certs/salesforce.key

JIRA_BASE_URL=https://company.atlassian.net
JIRA_USER_EMAIL=devops-agent@company.com
JIRA_API_TOKEN=ATATT3...

GITHUB_ORGANIZATION=your-enterprise-org
GITHUB_APP_ID=123456
GITHUB_APP_PRIVATE_KEY_PATH=./config/certs/github-app.pem

# --- Policy Engine & Compliance ---
POLICY_MODE=enforce                        # enforce | audit_only | dry_run
POLICY_STRICT_DESTRUCTION_PREVENTION=true
POLICY_MAX_DELETION_THRESHOLD=50           # Max fields/records deleted per agent run without Tier 3 approval

# --- Audit & Observability (Kafka / OpenTelemetry / S3) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
AUDIT_LOG_S3_BUCKET=cdm-os-immutable-audit-logs
AUDIT_HMAC_SECRET=hmac-signing-key-for-audit-trail
